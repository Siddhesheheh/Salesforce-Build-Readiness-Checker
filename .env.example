# Gemini API Key (keep server-side only; never commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_gemini_api_key_here

# Configurable Gemini model ID
LLM_MODEL=gemini-3.8-flash

# Optional feedback webhook URL for POST /api/feedback (Prompt C)
FEEDBACK_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
